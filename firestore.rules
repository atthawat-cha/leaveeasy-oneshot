// ─────────────────────────────────────────────────────────────
// firestore.rules — กฎเฝ้าข้อมูลของ LeaveEasy
// สัปดาห์ที่ 7: กฎขั้นต่ำ "ต้องล็อกอินก่อน ถึงอ่าน/เขียนได้"
// ยังไม่แยกสิทธิ์ตามบทบาท (employee/manager/hr) หรือตามเจ้าของใบลา
// กฎรายห้องครบชุดเป็นงานของสัปดาห์ที่ 8
// ─────────────────────────────────────────────────────────────

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    match /leaveTypes/{typeId} {
      allow read, write: if request.auth != null;
    }

    match /leaveRequests/{requestId} {
      allow read, write: if request.auth != null;

      match /approvals/{approvalId} {
        allow read, write: if request.auth != null;
      }

      match /aiLog/{logId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
